# Bookkeeping

update_script() {
    info "[branch:$branch] Checking for Update.."
    update="$($curl_exe --fail-with-body -sL -A "$agent" "https://raw.githubusercontent.com/pystardust/ani-cli/$branch/ani-cli")" || die "[branch:$branch] Connection error: $update"
    new_version="$(printf "%s" "$update" | sed -nE 's|^version_number="([^"]+)"$|\1|p')"
    [ -z "$new_version" ] && die "[branch:$branch] Invalid response."
    printf "%s" "$update" | grep -q "^version_number" || die "[branch:$branch] Invalid response."
    update="$(printf "%s\n" "$update" | diff -u "$0" -)"
    if [ -z "$update" ]; then
        info "[branch:$branch] Script is up to date :) ($version_number)"
    else
        if printf "%s\n" "$update" | patch "$0" -; then
            info "[branch:$branch] Updated: $version_number -> $new_version"
        else
            die "[branch:$branch] Failed to update. Read the above line!"
        fi
    fi
    exit 0
}

# checks if dependencies are present
dep_ch() {
    command -v "$1" >/dev/null || die "Program $1 not found. Please install it."
}

# checks for deps in order and returns the first available. format is "prog_a,prog_b,prog_c"
dep_ch_failover() {
    [ -z "$1" ] && return 1
    prog=$(printf "%s" "$1" | cut -d "," -f 1)
    rest=$(printf "%s" "$1" | cut -s -d "," -f 2-)
    command -v "$prog" >/dev/null 2>&1 && printf "%s" "$prog" && return 0
    [ -e "$prog" ] && printf "%s" "$prog" && return 0
    dep_ch_failover "$rest"
}

cleanup() {
    tput sgr0               # clears colors
    rm -f "${histfile}.new" # remove temp logfile
}

# SCRAPING

#shellcheck disable=SC2086
anidb_curl() {
    $curl_exe -sL -A "$agent" --max-time 10 $cipher_flag "$@"
}

# search the query and give results. format is (id \t name)
anidb_search() {
    #shellcheck disable=SC2059
    _page="$(anidb_curl "$(printf "$search_api" "$1")" | tr '\n' ' ' | sed 's|<a href|\n<a href|g')"
    if printf "%s" "$_page" | grep -qi "Just a moment"; then
        [ "$curl_exe" = "curl" ] && die "Blocked by cloudflare. Try installing curl-impersonate"
        die "Blocked by cloudflare."
    fi
    printf "%s" "$_page" | sed -nE 's|.*anime/([a-z0-9-]+-[0-9]+)".*alt="([^"]+)".*|\1\t\2|p' | sed -e "s|&#039;|'|g" -e 's|&quot;|"|g'
}

# extract mal_id and seasons metadata
anidb_desc() {
    #shellcheck disable=SC2059
    _page="$(anidb_curl "$(printf "$desc_api" "$1")" | tr '\n' ' ' | sed 's|<a href|\n<a href|g')"
    mal_id="$(printf "%s" "$_page" | sed -nE 's|.*https://myanimelist.net/anime/([0-9]+)/.*|\1|p')"
    seasons="$(printf "%s" "$_page" | sed -n '/>Seasons</,/>Details</p' | sed -nE 's|.*anime/([^"]+-[0-9]+)"[^>]*title="([^"]+)".*|\1\t\2|p' | sed -e "s|&#039;|'|g")"
    [ -n "$seasons" ] && seasons_option="\nchange_season"
}

# get the episodes list of the selected anime. format is (id \t ep_no)
anidb_episodes() {
    #shellcheck disable=SC2059
    _page="$(anidb_curl "$(printf "$episodes_api" "${1##*-}")")"
    printf "%s" "$_page" | sed 's|},{|}\n{|g' | sed -nE 's|.*"id":([0-9]+).*"number":([0-9]+).*|\1\t\2|p'
}

# extract the individual m3u8 links from response of embed urls
# $1 = episode number, $2 = language code (e.g. jpn, eng, fre)
anidb_m3u8() {
    _ep_id=$(printf "%s" "$episode_maps" | sed -nE "s|^([0-9]+)\t${1}$|\1|p")
    _lang="$2"
    #shellcheck disable=SC2059
    _page="$(anidb_curl "$(printf "$m3u8_api" "${_ep_id}")")"
    _embed="$(printf "%s" "$_page" | sed 's|},{|}\n{|g' | sed -nE 's|.*"code":"'"${_lang}"'".*embed_url":"([^"]+)".*|\1|p' | sed 's|\\/|/|g' | head -n 1)"
    [ -z "$_embed" ] && return 1
    _embed_page="$(anidb_curl "$_embed")"
    _m3u8_master="$(printf "%s" "$_embed_page" | sed -nE "s|.*file: '([^']*)'.*|\1|p" | head -n 1)"
    anidb_curl "${_m3u8_master}" | sed 's|^#EXT-X-STREAM.*x||g; s|,.*|p|g; /^#/d; $!N; s|\n| >|;/EXT-X-I-FRAME/d'
}

# list the languages available for an episode. format is (code \t pretty name)
anidb_languages() {
    _ep_id=$(printf "%s" "$episode_maps" | sed -nE "s|^([0-9]+)\t${1}$|\1|p")
    #shellcheck disable=SC2059
    _page="$(anidb_curl "$(printf "$m3u8_api" "${_ep_id}")")"
    printf "%s" "$_page" | sed 's|},{|}\n{|g' | sed -nE 's|.*"code":"([^"]+)".*"name":"([^"]+)".*|\1\t\2|p'
}

# normalize a language name or code to its ISO-639 code
normalize_lang() {
    case "$(printf "%s" "$1" | tr '[:upper:]' '[:lower:]')" in
        fra | fre | fr | french | francais | français) printf "fre\n" ;;
        en | eng | english | anglais) printf "eng\n" ;;
        jp | jpn | ja | japanese | japonais) printf "jpn\n" ;;
        de | deu | ger | german | allemand) printf "deu\n" ;;
        es | spa | spanish | espagnol) printf "spa\n" ;;
        pt | por | portuguese | portugais) printf "por\n" ;;
        it | ita | italian | italien) printf "ita\n" ;;
        ru | rus | russian | russe) printf "rus\n" ;;
        ko | kor | korean | coréen) printf "kor\n" ;;
        zh | chi | zho | chinese) printf "chi\n" ;;
        ar | ara | arabic) printf "ara\n" ;;
        hi | hin | hindi) printf "hin\n" ;;
        ta | tam | tamil) printf "tam\n" ;;
        *) printf "%s\n" "$1" ;;
    esac
}

# normalize a comma/space separated list of languages into space separated codes
normalize_lang_list() {
    printf "%s" "$1" | tr ',' '\n' | tr -s '[:space:]' '\n' | while read -r _l || [ -n "$_l" ]; do
        [ -z "$_l" ] && continue
        normalize_lang "$_l"
    done
}

# SITES: anime-sama and FRAnime (VF/VOSTFR)

plain_curl() {
    $curl_exe -sL -A "$agent" --max-time 25 "$@"
}

# ----------------------------- anime-sama -----------------------------

# resolve the currently active anime-sama domain (it changes regularly).
# mirrors the order used by the official status page anime-sama.pw
sama_resolve_domain() {
    for _tld in si tv to org fr eu; do
        _out=$($curl_exe -sL -o /dev/null -w "%{http_code} %{url_effective}" --max-time 8 -A "$agent" "https://anime-sama.${_tld}/" 2>/dev/null)
        _code="${_out%% *}"
        [ "$_code" = "200" ] || continue
        _host="$(printf '%s' "${_out#* }" | sed -E 's|^https?://([^/]+)/?.*$|\1|')"
        [ -n "$_host" ] && printf "%s" "$_host" && return 0
    done
    return 1
}

sama_require_domain() {
    [ -n "$sama_domain" ] && return 0
    info "Resolving active anime-sama domain..."
    sama_domain=$(sama_resolve_domain) || die "Could not reach any anime-sama domain!"
}

# search anime-sama. prints (sama:slug \t name)
sama_search() {
    sama_require_domain
    plain_curl -X POST --data-urlencode "query=$1" "https://${sama_domain}/template-php/defaut/fetch.php" |
        sed 's|<a href|\n<a href|g' |
        sed -nE 's|^<a href="https?://[^"]*/catalogue/([^"]+)" class="asn-search-result">.*asn-search-result-title">([^<]+)</h3>.*|\1\t\2|p' |
        sed -e 's|/\t|\t|' -e 's|/$||' -e "s|&#039;|'|g" -e 's|&quot;|"|g' -e 's|[[:space:]]*$||' |
        sort -u | sed 's|^|sama:|'
}

# list seasons of a catalogue entry. prints (base_path \t label)
sama_seasons() {
    sama_require_domain
    plain_curl "https://${sama_domain}/catalogue/${1}/" |
        grep -oE 'panneauAnime\("[^"]*", *"[^"]*"\)' |
        sed -E 's|panneauAnime\("([^"]*)", *"([^"]*)"\)|\2\t\1|' |
        awk -F'\t' '{ sub(/\/(vf|vostfr)\/?$/, "", $1); sub(/\/$/, "", $1); if ($1 != "" && $1 != "url" && $2 != "nom" && !seen[$1]++) print $1 "\t" $2 }'
}

# fetch episodes.js of a season+language and flatten its lecteurs arrays.
# prints rows: <lecteur_no>\t<episode_index>\t<url>
sama_eps_rows() {
    # $1 = slug, $2 = season base path, $3 = language (vf|vostfr)
    plain_curl "https://${sama_domain}/catalogue/${1}/${2}/${3}/episodes.js" | awk '
        index($0, "var eps") > 0 { n++ }
        n > 0 {
            c = split($0, p, "'\''")
            if (c >= 2 && p[2] ~ /^https?:\/\//) print n "\t" (++cnt[n]) "\t" p[2]
        }'
}

# count distinct episodes available for a language dataset
sama_eps_count() {
    printf "%s" "$1" | cut -f 2 | sort -n | tail -n 1
}

# pick best playable url for episode $2 within dataset $1 (rows: lecteur\tep\turl),
# trying lecteurs in ascending order until extraction succeeds
sama_pick_url() {
    printf "%s" "$1" | awk -F'\t' -v ep="$2" '$2 == ep { print $1 "\t" $3 }' | sort -n | while IFS='	' read -r _l _u; do
        [ -n "$_u" ] || continue
        _stream=$(extract_video_url "$_u")
        if [ -n "$_stream" ]; then
            printf "%s" "$_stream"
            exit 0
        fi
    done
}

# ------------------------------ FRAnime -------------------------------

fa_api() {
    $curl_exe -s -A "$agent" --max-time 30 -H "Accept: application/json" -H "Origin: https://franime.fr" -H "Referer: https://franime.fr/" "$1"
}

fa_require_deps() {
    [ -n "$json_bin" ] && return 0
    json_bin=$(dep_ch_failover "python3,jq") || die "FRAnime source requires python3 or jq. Please install one of them."
    command -v base64 >/dev/null || die "FRAnime source requires base64. Please install coreutils."
}

# search index (cached for a day). prints (franime:id \t name)
franime_search() {
    fa_require_deps
    _cache="${hist_dir}/franime-index.tsv"
    if [ ! -s "$_cache" ] || [ -n "$(find "$_cache" -mtime +1 2>/dev/null)" ]; then
        case "$json_bin" in
            python3)
                fa_api "https://api.franime.fr/api/animes" | python3 -c '
import sys, json
try:
    for a in json.load(sys.stdin):
        aid = a.get("id")
        t = a.get("title") or a.get("titleO") or ""
        t = str(t).replace("\t", " ").replace("\n", " ").strip()
        if aid is None or not t:
            continue
        print(str(aid) + "\t" + t)
except Exception:
    pass' >"$_cache" || : >"$_cache"
                ;;
            *)
                fa_api "https://api.franime.fr/api/animes" | jq -r '.[] | ((.title // .titleO // "") as $t | select(($t|length) > 0) | [(.id|tostring), ($t|gsub("[\\n\\t]";" "))] | join("\t"))' >"$_cache" 2>/dev/null || : >"$_cache"
                ;;
        esac
    fi
    # ne jamais afficher une entrée sans titre, quelle que soit l'état du cache
    grep -iE "$(printf '%s' "$1" | sed 's/ /[. ]+/g')" "$_cache" 2>/dev/null |
        awk -F'\t' 'NF >= 2 && $2 != ""' | head -n 30 | sed 's/^/franime:/'
}

# fetch details of an anime into a temp file, prints the file path
franime_details() {
