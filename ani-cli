# decrypt a watch2 url (base64 -> hex -> single byte xor) back to the provider url
decrypt_watch2() {
    _resp="$1"
    case "$_resp" in
        *watch2*) ;;
        *) return 1 ;;
    esac
    _q="${_resp#*\?}"
    _old_ifs=$IFS
    IFS='&'
    # shellcheck disable=SC2086
    set -- $_q
    IFS=$_old_ifs
    for _pair in "$@"; do
        _val="${_pair#*=}"
        _val="$(printf "%s" "$_val" | sed 's|%3D|=|g')"
        _hex="$(printf "%s" "$_val" | base64 -d 2>/dev/null || printf "%s" "$_val" | base64 -D 2>/dev/null)"
        printf "%s" "$_hex" | grep -Eq '^[0-9a-fA-F]+$' || continue
        _found="$(printf "%s" "$_hex" | awk '
            BEGIN { for (i = 0; i < 16; i++) { h = sprintf("%x", i); H[h] = i; H[toupper(h)] = i } }
            {
                s = $0; n = int(length(s) / 2)
                for (j = 1; j <= n; j++) B[j] = H[substr(s, 2 * j - 1, 1)] * 16 + H[substr(s, 2 * j, 1)]
                for (k = 1; k < 256; k++) {
                    r = ""
                    lim = n; if (lim > 14) lim = 14
                    for (j = 1; j <= lim; j++) {
                        d = f_xor(B[j], k)
                        if (d < 32 || d > 126) { r = "?"; break }
                        r = r sprintf("%c", d)
                    }
                    if (r ~ /^https?:\/\/../) {
                        full = ""
                        for (j = 1; j <= n; j++) full = full sprintf("%c", f_xor(B[j], k))
                        print full
                        exit
                    }
                }
            }
            function f_xor(a, b,  c, f) {
                c = 0; f = 1
                while (a > 0 || b > 0) {
                    if (a % 2 != b % 2) c += f
                    a = int(a / 2); b = int(b / 2); f = f * 2
                }
                return c
            }')"
        [ -n "$_found" ] && printf "%s" "$_found" && return 0
    done
    return 1
}

# extract a direct stream url from a provider page/embed
# $1 = player url. honours $extract_referer
extract_video_url() {
    _u="$1"
    _ref="${extract_referer:-https://franime.fr/}"
    case "$_u" in
        *video.sibnet.ru*)
            _page="$(plain_curl -H "Referer: ${_ref}" "$_u")"
            _path="$(printf "%s" "$_page" | grep -oE '/v/[a-f0-9]+/[0-9]+\.mp4' | head -n 1)"
            [ -z "$_path" ] && return 1
            _loc=$($curl_exe -s -o /dev/null -w "%{redirect_url}" --max-time 20 -A "$agent" -H "Referer: $_u" "https://video.sibnet.ru${_path}")
            [ -n "$_loc" ] && printf "%s" "$_loc"
            ;;
        *)
            # isolate every quoted string then look for stream urls
            _urls="$(plain_curl -H "Referer: ${_ref}" "$_u" | sed 's|["'\'']|\n|g' | grep -E '^https?://[^[:space:]]+\.(m3u8|mp4)[^[:space:]]*$')"
            [ -z "$_urls" ] && return 1
            printf "%s" "$_urls" | head -n 1 | sed 's|&amp;|\&|g'
            ;;
    esac
}

# --------------------- per-site episode preparation ---------------------

# build ep_list/episode_maps from a max count
site_seq_episodes() {
    [ -n "$1" ] && [ "$1" -gt 0 ] 2>/dev/null || die "No episodes found for this season!"
    ep_list=$(awk -v n="$1" 'BEGIN { for (i = 1; i <= n; i++) print i }')
    episode_maps=$(printf "%s" "$ep_list" | awk '{ print $1 "\t" $1 }')
    seasons_option="
change_season"
}

# load both language datasets of the current sama season
sama_load_episodes() {
    sama_require_domain
    _slug="$(printf '%s' "$anime_id" | sed 's|^sama:||; s|@[^@]*$||')"
    sama_data_vostfr="$(sama_eps_rows "$_slug" "$season_path" vostfr)"
    sama_data_vf="$(sama_eps_rows "$_slug" "$season_path" vf)"
    _n_vo="$(sama_eps_count "$sama_data_vostfr")"
    _n_vf="$(sama_eps_count "$sama_data_vf")"
    _max="$_n_vo"
    [ "${_n_vf:-0}" -gt "${_max:-0}" ] 2>/dev/null && _max="$_n_vf"
    site_seq_episodes "$_max"
}

# search flow: choose season then load episodes
sama_prepare() {
    sama_require_domain
    _slug="${anime_id#sama:}"
    seasons="$(sama_seasons "$_slug")"
    # catalogue entries without anime seasons (scans) are skipped automatically
    # when the selection was made non-interactively with -S
    while [ -z "$seasons" ] && [ -n "${index:-}" ]; do
        sama_skip=${sama_skip:-0}
        [ "$sama_skip" -ge 5 ] && break
        sama_skip=$((sama_skip + 1))
        _next_row=$((index + sama_skip))
        _r="$(printf "%s" "$anime_list" | sed -n "${_next_row}p")"
        [ -z "$_r" ] && break
        anime_title="$(printf "%s" "$_r" | cut -f 2)"
        anime_id="$(printf "%s" "$_r" | cut -f 1)"
        info "'$_slug' has no anime season, trying '$anime_title'..."
        _slug="${anime_id#sama:}"
        seasons="$(sama_seasons "$_slug")"
    done
    [ -z "$seasons" ] && die "No anime seasons found for this entry!"
    if [ -z "$season_path" ]; then
        _count=$(printf "%s" "$seasons" | wc -l | tr -d "[:space:]")
        if [ "$_count" -gt 1 ] && [ -z "${index:-}" ]; then
            season_path=$(printf "%s" "$seasons" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select season: " | cut -f 1)
        else
            season_path=$(printf "%s" "$seasons" | head -n 1 | cut -f 1)
        fi
        [ -z "$season_path" ] && die "Invalid season selection"
    fi
    anime_id="sama:${_slug}@${season_path}"
    sama_load_episodes
}

# load episode list of the current franime saison
franime_load_episodes() {
    fa_require_deps
    _n="$(franime_eps_count "$details_file" "$current_saison")"
    site_seq_episodes "$_n"
}

# search flow: fetch details, choose saison then load episodes
franime_prepare() {
    fa_require_deps
    details_file="$(franime_details "${anime_id##*:}")" || die "Could not fetch anime details!"
    seasons="$(franime_seasons_list "$details_file")"
    [ -z "$seasons" ] && die "No seasons found!"
    if [ -z "$current_saison" ]; then
        _count=$(printf "%s" "$seasons" | wc -l | tr -d "[:space:]")
        if [ "$_count" -gt 1 ] && [ -z "${index:-}" ]; then
            current_saison=$(printf "%s" "$seasons" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select season: " | cut -f 1)
        else
            current_saison=$(printf "%s" "$seasons" | head -n 1 | cut -f 1)
        fi
        [ -z "$current_saison" ] && die "Invalid season selection"
    fi
    anime_id="franime:${anime_id##*:}@${current_saison}"
    franime_load_episodes
